---
import Wrapper from "../Wrapper.astro";
import Text from "../Text.astro";

const otherprojects = [
  {
    url: "https://www.lexingtonthemes.com/",
    title: "Lexington Themes",
    description:
      "Premium Astro and Tailwind themes and UI kits for designers, developers, and teams. Simple to customize.",
  },
  {
    url: "https://kobbe.io/",
    title: "Kobbe",
    description:
      "Privacy-first web analytics with traffic and revenue in one place. Cookieless by default, GDPR-ready, set up in seconds.",
  },
  {
    url: "https://www.oxbowui.com/",
    title: "Oxbow UI",
    description:
      "Free and premium Tailwind components, elements, and layouts. Easy to customize.",
  },
  {
    url: "https://www.colorsandfonts.com/",
    title: "Colors & Fonts",
    description:
      "Curated color and typography resources for designers and developers.",
  },
];
---

<section id="projects" class="bg-ink text-paper">
  <Wrapper class="py-20 md:py-32">
    <div class="flex justify-between">
      <div>
        <Text variant="meta" class="text-accent">03</Text>
        <Text variant="meta" class="mt-1 text-paper/40">Projects</Text>
      </div>
      <Text variant="meta" class="max-w-32 text-right text-paper/40">
        Selected work · 2023–2026
      </Text>
    </div>

    <Text variant="display" class="my-20 md:my-28">
      Selected<br />projects.
    </Text>

    <ul class="border-t border-paper" role="list">
      {
        otherprojects.map((project, index) => (
          <li
            class="group border-b border-paper"
            data-reveal
            data-reveal-delay={index * 100}
          >
            <a
              href={project.url}
              class="grid grid-cols-12 gap-6 md:gap-8 py-10 md:py-14 items-end outline-none focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4"
            >
              <Text
                variant="projectTitle"
                class="col-span-12 md:col-span-8 group-hover:text-accent motion-safe:transition-colors motion-safe:duration-200"
              >
                {project.title}
              </Text>
              <div class="col-span-12 md:col-span-4 md:text-right">
                <Text variant="meta" class="text-paper/40">
                  0{index + 1}
                </Text>
                <Text class="mt-3 max-w-[60ch] md:ml-auto text-paper/60">
                  {project.description}
                </Text>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Wrapper>
</section>
