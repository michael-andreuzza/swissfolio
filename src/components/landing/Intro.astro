---
import Wrapper from "../Wrapper.astro";
import Text from "../Text.astro";
---

<section id="about" class="bg-paper text-ink">
  <Wrapper class="py-20 md:py-32">
    <div class="flex justify-between">
      <div>
        <Text variant="meta" class="text-accent">02</Text>
        <Text variant="meta" class="mt-1 text-ink/40">Profile</Text>
      </div>
      <Text variant="meta" class="max-w-32 text-right text-ink/40">
        Independent creative practice
      </Text>
    </div>

    <Text
      variant="display"
      class="mt-20 md:mt-32"
      data-reveal
    >
      Clear ideas.<br />
      Bold systems.<br />
      <span class="text-accent">Built to last.</span>
    </Text>

    <div
      class="mt-20 md:mt-32 grid grid-cols-12 border-t border-ink"
    >
      <Text class="col-span-12 py-6 md:col-span-4 md:pr-8">
        I’m Jarvis, an independent designer and developer creating identities,
        websites, and digital products for teams around the world.
      </Text>
      <Text
        class="col-span-12 border-t border-ink py-6 md:col-span-4 md:border-l md:border-t-0 md:px-8"
      >
        My work moves from strategy and art direction through interface design
        and production, keeping one clear idea intact from start to finish.
      </Text>
      <div
        class="col-span-12 md:col-span-4 py-6 border-t md:border-t-0 md:border-l border-ink md:pl-8"
      >
        <Text>
          I partner with a small number of clients at a time, working closely
          with the people making the decisions.
        </Text>
        <Text
          tag="a"
          variant="meta"
          href="mailto:hello@jarvis.studio"
          class="mt-8 inline-flex min-h-[44px] items-center text-accent outline-none focus-visible:outline-2 focus-visible:outline-ink focus-visible:outline-offset-2 hover:opacity-60"
          >Start a project ↗</Text
        >
      </div>
    </div>
  </Wrapper>
</section>
