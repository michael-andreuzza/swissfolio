---
import Wrapper from "../Wrapper.astro";
import Text from "../Text.astro";
---

<section class="overflow-hidden bg-ink text-paper">
  <Wrapper class="pt-8 md:pt-10">
    <div
      class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between"
    >
      <Text
        variant="meta"
        class="max-w-xs text-paper/60 md:max-w-none md:whitespace-nowrap"
      >
        design engineer · product designer
      </Text>
      <ul class="flex flex-wrap gap-x-6">
        <li>
          <Text
            tag="a"
            variant="meta"
            href="https://github.com/michael-andreuzza"
            class="inline-flex min-h-[44px] items-center text-paper/60 outline-none hover:text-paper focus-visible:outline-2 focus-visible:outline-paper focus-visible:outline-offset-2"
            >GitHub</Text
          >
        </li>
        <li>
          <Text
            tag="a"
            variant="meta"
            href="https://lexingtonthemes.com"
            class="inline-flex min-h-[44px] items-center text-paper/60 outline-none hover:text-paper focus-visible:outline-2 focus-visible:outline-paper focus-visible:outline-offset-2"
            >Astro themes</Text
          >
        </li>
        <li>
          <Text
            tag="a"
            variant="meta"
            href="https://michaelandreuzza.com"
            class="inline-flex min-h-[44px] items-center text-paper/60 outline-none hover:text-paper focus-visible:outline-2 focus-visible:outline-paper focus-visible:outline-offset-2"
            >Author</Text
          >
        </li>
      </ul>
    </div>

    <Text tag="h1" variant="wordmark" class="my-20 md:my-28" data-reveal
      >Jarvis</Text
    >

    <div
      class="flex flex-col gap-2 pb-8 text-paper/40 sm:flex-row sm:justify-between"
    >
      <Text variant="meta">Amsterdam, NL</Text>
      <Text variant="meta">Available for selected projects · 2026</Text>
    </div>
  </Wrapper>

  <div class="bg-accent text-ink">
    <Wrapper
      class="grid grid-cols-12 items-end gap-4 py-8 md:gap-8 md:py-24"
      data-reveal
    >
      <Text variant="displayHero" class="col-span-12 md:col-span-9">
        Ideas.<br />Systems.<br />Experiences.
      </Text>
      <div class="col-span-12 md:col-span-3">
        <Text class="max-w-xs">
          I shape clear identities and digital products for ambitious people
          building what comes next.
        </Text>
        <Text
          tag="a"
          variant="meta"
          href="mailto:hello@jarvis.studio"
          class="mt-8 inline-flex min-h-[44px] items-center outline-none hover:opacity-60 focus-visible:outline-2 focus-visible:outline-ink focus-visible:outline-offset-2"
          >Start a project ↗</Text
        >
      </div>
    </Wrapper>
  </div>
</section>
