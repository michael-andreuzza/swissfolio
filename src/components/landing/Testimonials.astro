---
import Wrapper from "../Wrapper.astro";
import Text from "../Text.astro";

const testimonials = [
  {
    name: "Elena Voss",
    role: "Founder, Northline",
    opinion:
      "Jarvis found the idea we were struggling to articulate and turned it into a system that felt unmistakably ours. The work was sharp, thoughtful, and built to grow with us.",
  },
  {
    name: "Marcus Chen",
    role: "Creative Director, Forma",
    opinion:
      "He moves easily between the big picture and the smallest interaction. Every decision had a reason, and the final product was stronger because of that discipline.",
  },
  {
    name: "Imani Brooks",
    role: "Editor, Common Ground",
    opinion:
      "The process was direct and collaborative. Jarvis listened carefully, challenged the right things, and gave the publication a digital identity with real character.",
  },
  {
    name: "Theo Martin",
    role: "Product Lead, Fieldwork",
    opinion:
      "Jarvis brought clarity to a complicated product without sanding away what made it different. The result feels simple, confident, and genuinely useful.",
  },
];
---

<section class="bg-accent text-paper">
  <Wrapper class="py-20 md:py-32">
    <div class="flex justify-between">
      <div>
        <Text variant="meta">04</Text>
        <Text variant="meta" class="mt-1 text-paper/50">Opinions</Text>
      </div>
      <Text variant="meta" class="max-w-32 text-right text-paper/50">
        In their own words
      </Text>
    </div>

    <Text variant="display" class="my-20 md:my-28 text-center">
      People<br />talk.
    </Text>

    <ul class="grid grid-cols-12 border-t border-l border-paper" role="list">
      {
        testimonials.map((item, index) => (
          <li
            class="col-span-12 md:col-span-6 flex flex-col justify-between gap-12 border-b border-r border-paper p-6 md:p-8 min-h-full"
            data-reveal
            data-reveal-delay={index * 100}
          >
            <Text tag="blockquote" variant="quote" class="max-w-[60ch]">
              {item.opinion}
            </Text>
            <footer>
              <Text variant="meta">{item.name}</Text>
              <Text variant="meta" class="mt-1 text-paper/50">
                {item.role}
              </Text>
            </footer>
          </li>
        ))
      }
    </ul>
  </Wrapper>
</section>
